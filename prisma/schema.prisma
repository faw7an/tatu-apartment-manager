generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums 
enum Role {
  LANDLORD 
  TENANT
}

enum BillStatus { 
  UNPAID
  PAID
  OVERDUE
}

enum NoticeType {
  GENERAL
  PAYMENT_OVERDUE
  EVICTION
  MAINTENANCE
  ANNOUNCEMENT
}

